{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--codegen",
        "typescript"
      ]
    },
    "angular-cli": {
      "command": "npx",
      "args": [
        "@angular/cli",
        "mcp",
        "--read-only"
      ]
    }
  }
}
